# Production Dockerfile for Streamlit ECG Analysis Dashboard
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    OMP_NUM_THREADS=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md /app/
COPY src/ /app/src/
COPY artifacts/ /app/artifacts/
COPY configs/ /app/configs/
COPY data/processed/test/ /app/data/processed/test/

RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir numpy scipy pandas scikit-learn fastapi uvicorn onnxruntime pydantic pyyaml tqdm wfdb requests streamlit plotly && \
    pip install --no-cache-dir --no-deps -e .

RUN useradd -m -u 10001 appuser && \
    chown -R appuser:appuser /app

USER appuser

EXPOSE 8501

HEALTHCHECK --interval=10s --timeout=5s --retries=3 --start-period=10s \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8501/_stcore/health')"

CMD ["streamlit", "run", "src/ecg_arrhythmia/deployment/dashboard.py", "--server.address", "0.0.0.0", "--server.port", "8501"]
