# Production Dockerfile for FastAPI ONNX INT8 Inference Service
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    OMP_NUM_THREADS=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md /app/
COPY src/ /app/src/
COPY artifacts/ /app/artifacts/
COPY configs/ /app/configs/

RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir numpy scipy pandas scikit-learn fastapi uvicorn onnxruntime pydantic pyyaml tqdm wfdb requests && \
    pip install --no-cache-dir --no-deps -e .

RUN useradd -m -u 10001 appuser && \
    chown -R appuser:appuser /app

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=5s --timeout=3s --retries=5 --start-period=5s \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/ready')"

CMD ["uvicorn", "ecg_arrhythmia.deployment.api:app", "--host", "0.0.0.0", "--port", "8000"]
